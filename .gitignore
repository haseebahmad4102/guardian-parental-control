*.iml
.idea/
*.ipr
*.iws

# Keystore and signing keys
*.jks
*.keystore
*.key

# Firebase config — each developer supplies their own from the Firebase console.
# Do NOT commit real google-services.json. The committed *.template files show the shape.
parent/google-services.json
child/google-services.json

# Node (Cloud Functions + rules tests)
node_modules/
firebase/**/node_modules/
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Log Files
*.log

